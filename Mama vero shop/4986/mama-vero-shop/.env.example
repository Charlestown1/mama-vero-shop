# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# MongoDB
MONGODB_URI=your_mongodb_atlas_connection_string

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Session (needed for passport OAuth handshake)
SESSION_SECRET=replace_with_a_long_random_secret

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Google Cloud Storage (payment proof / product images)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_BUCKET=
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=

# Bank transfer details shown to customers at checkout
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# First admin account creation (used only by seed/createAdmin.js)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
